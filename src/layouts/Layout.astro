---
import Image from "astro/components/Image.astro";
import DownloadIcon from "../components/icons/DownloadIcon.astro";

interface Props {
  title: string;
  description: string;
  ogId?: string;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={Astro.props.description} />
    <title>{Astro.props.title}</title>
    <link rel="preconnect" href="/" crossorigin />
    <link rel="preload" href="/profile.webp" as="image" />
    <link rel="icon" href="/profile.webp" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Dominic"
      href={`${Astro.site}rss.xml`}
    />

    <!-- OpenGraph tags -->
    <meta name="og:title" content={Astro.props.title} />
    <meta property="og:title" content={Astro.props.title} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en" />
    <meta property="og:description" content={Astro.props.description} />
    <meta property="og:site_name" content="Dominic" />
    <meta property="og:url" content="https://cv.dominicolanya.dev" />
    <meta property="og:image" content="https://cv.dominicolanya.dev/profile.webp" />

    <!-- Twitter tags -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@dominicolanya" />
    <meta name="twitter:title" content={Astro.props.title} />
    <meta name="twitter:description" content={Astro.props.description} />

    <!-- Discord -->
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body class="mx-auto max-w-3xl">
    <header
      class="flex place-content-between place-items-center p-4 pb-2 sm:pt-6 md:px-0"
    >
      <a class="block" href="/" aria-label="Home">
        <Image
          loading="eager"
          src="/profile.webp"
          alt="Dominic"
          height={32}
          width={32}
          class="h-8 w-8 rounded-full bg-primary transition-transform duration-200 ease-in-out hover:scale-110 sm:h-10 sm:w-10"
        />
      </a>
      <div class="flex items-center gap-2">
        <button
          id="theme-toggle"
          class="h-8 w-8 rounded-full bg-primary hover:bg-primary-hover transition-transform duration-200 ease-in-out hover:scale-110 sm:h-10 sm:w-10 flex justify-center items-center cursor-pointer"
          aria-label="Toggle dark mode"
        >
          <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" class="h-[1.375rem] w-[1.375rem] hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.25">
            <title>Light mode</title>
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 7a5 5 0 1 0 0 10A5 5 0 0 0 12 7z" />
          </svg>
          <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" class="h-[1.375rem] w-[1.375rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.25">
            <title>Dark mode</title>
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>
        <a
          class="focus-visible:bg-primay-active active:bg-primay-active hover:bg-primary-hover h-8 w-8 rounded-full bg-primary transition-transform duration-200 ease-in-out hover:scale-110 sm:h-10 sm:w-10 flex justify-center items-center cursor-pointer"
          href="/dominic-resume.pdf"
          download="dominic-resume.pdf"
          aria-label="Download Resume"
        >
          <DownloadIcon class="h-[1.375rem] w-[1.375rem] stroke-[1.25]" />
        </a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <script is:inline>
      const toggle = document.getElementById('theme-toggle');
      const iconSun = document.getElementById('icon-sun');
      const iconMoon = document.getElementById('icon-moon');
      const html = document.documentElement;

      // Apply saved theme on load
      if (localStorage.theme === 'dark') {
        html.classList.add('dark');
        iconSun.classList.remove('hidden');
        iconMoon.classList.add('hidden');
      }

      toggle.addEventListener('click', () => {
        const isDark = html.classList.toggle('dark');
        localStorage.theme = isDark ? 'dark' : 'light';
        iconSun.classList.toggle('hidden', !isDark);
        iconMoon.classList.toggle('hidden', isDark);
      });
    </script>
  </body>
</html>
